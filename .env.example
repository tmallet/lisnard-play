# URL de base de l'API pour les clients mobiles (sur le web, l'API est appelée en relatif).
# En développement, si vide, l'hôte de Metro est utilisé.
EXPO_PUBLIC_API_URL=

# Base de données (ADR 0014). Local : `docker compose up -d` (port 5433).
# Devcontainer : postgres://lisnard:lisnard@postgres:5432/lisnard
DATABASE_URL=postgres://lisnard:lisnard@localhost:5433/lisnard

# Worker uniquement (ADR 0004, 0017). Ne jamais commiter de vraie valeur.
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
# Plafond quotidien des résumés de vidéos, en dollars (ADR 0021). Défaut : 1.
# SUMMARY_DAILY_BUDGET_USD=1
# Notifications push YouTube (ADR 0023) : les deux ou aucune. Sans elles, la collecte
# périodique suffit. Le secret compte au moins 32 caractères (openssl rand -hex 32).
# WEBSUB_CALLBACK_URL=https://hooks.lisnardplay.thimal.fr/websub/youtube
# WEBSUB_SECRET=
# WEBSUB_PORT=8080

# Notifications web (ADR 0024) : bunx web-push generate-vapid-keys. Clé publique :
# app et worker ; clé privée : worker seulement. Ne jamais les changer en production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:lisnardplay@tmallet.fr
# Données d'adhésion (ADR 0026) : base des fichiers JSON du parti, lue par l'app.
# Par défaut https://adherent.unenouvelleenergie.fr/donnees ; à changer pour des tests.
# MEMBERSHIP_SOURCE_URL=

# Facultatif : jeton d'accès Expo Push (notifications mobiles, worker seulement).
# EXPO_ACCESS_TOKEN=

# Origine déclarée par le lecteur vidéo mobile (défaut : https://lisnardplay.thimal.fr).
# EXPO_PUBLIC_SITE_URL=https://lisnardplay.thimal.fr

# Serveur web : indexation par les moteurs de recherche, bloquée sauf « true ».
# ALLOW_INDEXING=true
