# URL de base de l'API pour les clients mobiles (sur le web, l'API est appelée en relatif).
# En développement, si vide, l'hôte de Metro est utilisé.
EXPO_PUBLIC_API_URL=

# Base de données (ADR 0014). Local : `docker compose up -d` (port 5433).
# Devcontainer : postgres://lisnard:lisnard@postgres:5432/lisnard
DATABASE_URL=postgres://lisnard:lisnard@localhost:5433/lisnard

# Worker uniquement (ADR 0004, 0017). Ne jamais commiter de vraie valeur.
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=

# Origine déclarée par le lecteur vidéo mobile (défaut : https://lisnard-play.app).
# EXPO_PUBLIC_SITE_URL=https://lisnard-play.app
