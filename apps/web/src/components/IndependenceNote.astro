---
/**
 * Mention d'indépendance en tête de contenu, en petit (téléphone) : visible dès
 * l'ouverture sans interaction (spec app-shell, ADR 0001).
 */
import { INDEPENDENCE_NOTICE } from '@/config/app';
import LegalLink from './LegalLink.astro';
---
<p class="flex flex-wrap items-baseline gap-x-3">
  <span class="font-sans text-blanc/70 text-xs leading-snug">{INDEPENDENCE_NOTICE}</span>
  <LegalLink small />
</p>
