---
/**
 * Pied de page (dès la largeur md) : mention d'indépendance (ADR 0001), mentions légales
 * (ADR 0022) et lien vers les outils du collectif, collé en bas de l'écran.
 */
import { INDEPENDENCE_NOTICE } from '@/config/app';
import LegalLink from './LegalLink.astro';
---
<footer class="sticky bottom-0 hidden flex-wrap items-baseline gap-x-4 gap-y-1 border-blanc/15 border-t bg-bleu-sombre/95 px-6 py-3 backdrop-blur md:flex">
  <p class="font-sans text-blanc/70 text-sm">{INDEPENDENCE_NOTICE}</p>
  <LegalLink />
  <a href="https://www.projetlisnard.fr/" class="font-sans-semibold text-chamois text-sm underline">
    Tous les outils Projet Lisnard
  </a>
</footer>
