---
/**
 * Un filtre de l'accueil (spec intervention-feed) : titre visible, options en liens
 * (fonctionnent sans JavaScript), option active signalée. `segmented` : sélecteur groupé.
 */
interface Props {
  title: string;
  label: string;
  options: { label: string; href: string; selected: boolean }[];
  segmented?: boolean;
}
const { title, label, options, segmented = false } = Astro.props;
---
<div class="flex flex-col gap-2">
  <p class="font-sans-bold text-xs uppercase tracking-wider text-blanc/70">{title}</p>
  <ul
    aria-label={label}
    class:list={[
      segmented
        ? 'flex flex-wrap self-start gap-1 rounded-[22px] bg-blanc/10 p-1'
        : 'flex flex-wrap gap-1.5 md:gap-2',
    ]}
  >
    {options.map((option) => (
      <li class="flex">
        <a
          href={option.href}
          aria-current={option.selected ? 'true' : undefined}
          class:list={[
            'flex min-h-11 items-center rounded-full border px-4 font-sans-semibold text-sm transition-colors duration-200 ease-out active:scale-95 motion-reduce:transition-none motion-reduce:active:scale-100 md:min-h-9',
            option.selected
              ? 'border-chamois bg-chamois text-bleu-sombre'
              : segmented
                ? 'border-transparent text-blanc hover:bg-blanc/10'
                : 'border-blanc/45 text-blanc hover:bg-blanc/10',
          ]}
        >
          {option.label}
        </a>
      </li>
    ))}
  </ul>
</div>
