    "@lisnard/db": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.104.2",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "astro": "7.4.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "satori": "0.18.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@testing-library/dom": "10.4.2",
